# Copy to .env, mode 600, then fill in real values. Never commit .env.

# Required - Mealie API token for the user recipe-import writes as.
MEALIE_TOKEN=changeme

# Required - Home Assistant long-lived access token, used to push a notification
# after each import.
HA_TOKEN=changeme

# Required - name of the Home Assistant notify.* channel to push to, without the
# "notify." prefix (e.g. mobile_app_your_phone). Must accept a data.url field so the
# notification can link to the imported recipe - a plain notify.send_message channel
# cannot.
HA_NOTIFY_TARGET=changeme

# Required - API key for the LLM fallback used when structured recipe data can't be
# scraped from the page (recipe-scrapers/extruct/trafilatura all come up empty).
LLM_API_KEY=changeme

# Required - bearer token for POST /import/file (the image/PDF upload path). Generate
# with: openssl rand -hex 24
IMPORT_TOKEN=changeme

# Optional - override only if your setup differs from the defaults below.
#MEALIE_URL=http://localhost:30081
#HA_URL=http://localhost:8123
#LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#LLM_MODEL=gemini-3.6-flash
#DB_PATH=/data/recipe-import.db
#RATE_LIMIT_PER_HOUR=20
#LOG_LEVEL=INFO

# Optional - the text model is a chain, not a single name. The first entry is the model
# normally used, the rest are fallbacks that only answer when an earlier one cannot.
#
# Why: measured against a live key on 2026-09-20, gemini-3.6-flash - the model this
# service used to pin - answered 429 "You exceeded your current quota" on every request,
# while gemini-3.8-flash and gemini-3.5-flash answered 200 in the same minute. A single
# pinned name means every import fails until somebody edits this file.
#
# Two 429 in a row mark a model exhausted and move the call to the next one. Two
# 502/503/504 also move on, but without a cooldown - that is one model under load, and it
# passes in minutes. A 404 drops the name for the lifetime of the process. 500 keeps the
# old behaviour and does not switch. Only an exhausted chain parks the import.
#
# LLM_MODEL above still works: set explicitly, it becomes the head of the chain and the
# default list follows underneath it.
#LLM_MODEL_CHAIN=gemini-3.8-flash, gemini-3.7-flash, gemini-3.6-flash, gemini-3.5-flash

# How long an exhausted model is skipped, in seconds. Default one hour, so a used-up
# quota costs one rejected call per hour instead of one per import. In-memory only - a
# restart starts again at the head of the chain.
#LLM_MODEL_COOLDOWN_SECONDS=3600

# Optional - default true. Reads GET {LLM_BASE_URL}/models at startup and then every
# LLM_MODEL_REFRESH_SECONDS, and puts a model newer than the current head in front of the
# chain. A newly discovered model is used for real imports only after it has answered one
# minimal request with response_format: json_schema, strict - the contract the whole text
# stage depends on. Every adoption is logged and pushed once, naming old and new model.
#
# This reverses the older "pin the model, a switch should be a deliberate change" rule
# for the text model. To get it back: set this to false and LLM_MODEL_CHAIN to one name.
# That reproduces the pre-A21 behaviour exactly, without reverting any code.
#LLM_MODEL_AUTODISCOVER=true

# Which names from the provider's model list are considered at all. The two groups are
# major and minor version and are compared as numbers, so 3.10 sorts above 3.9. Kept
# deliberately narrow: it excludes gemini-flash-latest (a moving alias),
# gemini-3-flash-preview, the -lite variants, and every image/live/tts model that sat in
# the same list on 2026-09-20.
#LLM_MODEL_PATTERN=^gemini-(\d+)\.(\d+)-flash$

# How often the model search runs, in seconds. Once a day: new models appear in weeks,
# not minutes, and a run costs one list request plus at most one probe.
#LLM_MODEL_REFRESH_SECONDS=86400

# Optional - upload path limits (POST /import/file). MAX_UPLOAD_MB is the combined
# size of all files in one request; requests over the limit are rejected, not truncated.
#MAX_UPLOAD_MB=12
#MAX_UPLOAD_FILES=4
#MAX_PDF_PAGES=10

# Optional - default true. After extraction, an extra LLM call rewrites the recipe
# title into something readable (drops author/site name/emoji/"recipe"). Costs one
# additional LLM call per import; set to false to skip it.
#NAMING_ENABLED=true

# Optional - default true. After the recipe is in Mealie, a picture is generated for it
# and uploaded - but only when the recipe has no image yet, so a photo Mealie scraped
# from the source page is never replaced. Recipes that got a generated picture carry the
# tag "ki-bild" next to "auto-import".
#
# Cost warning: an image call is markedly more expensive than every text call this
# service makes, and with the default chain below it spends real Gemini credit - about
# $0.134 per picture. It runs at most once per candidate per import, stops at the first
# usable picture, never runs on a repeated import of the same source, and
# RATE_LIMIT_PER_HOUR stays the ceiling. Set to false to switch the whole stage off;
# pictures already uploaded stay.
#IMAGE_ENABLED=true

# Optional - the ordered chain of image candidates, best first, as "provider:model"
# entries. The first entry is what the service normally uses; the rest are fallbacks,
# reached only when an earlier one cannot deliver a picture. Three provider forms:
#   gemini        POST /v1beta/models/{model}:generateContent on Google's native surface.
#                 Costs credit. This is where the good pictures come from.
#   pollinations  free, no account, no key. A GET whose answer is the image itself.
#   openai        an OpenAI-compatible provider serving /images/generations.
#
# The default puts the paid models first and the free one underneath, so a spent credit
# costs picture quality rather than the picture. Measured 2026-09-20 against a credited
# key: gemini-3-pro-image answers in 15.3 s and costs $0.134 a picture,
# gemini-3.1-flash-image in 8.6 s for $0.067, both 1024x1024 and without a watermark.
# $5 of credit is therefore about 37 pictures from the pro model.
#
# An entry naming an unknown provider, or no model, is dropped with a warning: the
# picture stage must never cost a start.
#IMAGE_MODEL_CHAIN=gemini:gemini-3-pro-image, gemini:gemini-3.1-flash-image, pollinations:sana

# Optional - how long a candidate is skipped after it reported its quota, credit or rate
# limit spent. An empty credit then costs one rejected call per hour instead of one per
# import. In-process only: a restart starts at the top of the chain again.
#IMAGE_MODEL_COOLDOWN_SECONDS=3600

# Optional - time budget for the WHOLE picture stage of one import, not for one call.
# The push notification waits for this stage, so a chain of three candidates must not be
# able to take three timeouts. A candidate is skipped when the remaining budget no longer
# covers its own timeout (60 s for gemini, 90 s otherwise).
#IMAGE_DEADLINE_SECONDS=150

# Optional - the pinned provider and model, kept from before the chain existed. Set
# either of them explicitly and that pair becomes the FIRST candidate of the chain, with
# the default entries below it as fallbacks; IMAGE_MODEL_CHAIN overrides both.
# Values: gemini, pollinations, openai. An unknown value falls back to pollinations.
# The model is pinned to an exact id (no "latest" alias) and must be one the provider
# serves. Without a token Pollinations serves exactly one model, sana; flux and turbo are
# accepted but answered by the same model.
#IMAGE_PROVIDER=pollinations
#IMAGE_MODEL=sana

# Optional - address and credential for the provider named in IMAGE_PROVIDER, and for
# that one only. The other providers keep their own defaults, which is what stops the
# text model's key from being sent to Pollinations. Defaults per provider: the
# LLM_BASE_URL host without its /openai suffix plus LLM_API_KEY for gemini, the
# LLM_BASE_URL / LLM_API_KEY values above for openai, and https://image.pollinations.ai
# with no key for pollinations.
#
# A Pollinations token (free, from auth.pollinations.ai) makes the service honour the
# requested picture size; without one every answer is 768x768. It does NOT remove the
# "pollinations.ai" watermark in the bottom right corner - measured 2026-09-20 with a
# free token - that needs a paid tier. Every picture from that provider carries it.
#IMAGE_BASE_URL=https://image.pollinations.ai
#IMAGE_API_KEY=changeme

# Optional - retry queue for imports that failed because an upstream said "try later"
# (the model at capacity, YouTube throttling subtitles, Mealie unreachable). Such an
# import is parked with a due time instead of being thrown away, and retried
# automatically; everything else still fails immediately with the same wording.

# How often the background loop looks for due entries, in seconds. Coarse on purpose -
# delays are measured in minutes, and one tick is a single indexed SQLite query.
#QUEUE_POLL_SECONDS=30

# Backoff between retries, in minutes: base * factor ** (attempts - 1), so with the
# defaults 2, 6, 18, 54 minutes, each with +/-25% random jitter so several imports
# parked at the same moment do not retry in lockstep.
#QUEUE_BACKOFF_BASE_MINUTES=2
#QUEUE_BACKOFF_FACTOR=3

# Once the computed delay exceeds this many minutes, the import is not delayed further
# but parked at a random point inside the next off-peak window instead.
#QUEUE_OFFPEAK_THRESHOLD_MINUTES=60

# The off-peak window as HH:MM-HH:MM in the container's local time - the hours at which
# upstream capacity is expected to be easier to get. A window across midnight
# ("22:00-04:00") is allowed. A malformed value aborts the start naming this variable,
# rather than silently falling back to the default.
#QUEUE_OFFPEAK_WINDOW=02:00-06:00

# When to give up. Both bounds apply and the first one reached wins: the attempt count
# bounds the cost, the age bounds how long "later" may mean. Giving up marks the import
# failed and sends one final notification asking for the source again.
#QUEUE_MAX_ATTEMPTS=5
#QUEUE_MAX_AGE_HOURS=24

# Where the bytes of a queued photo or PDF import are kept so the retry does not need a
# new upload. Defaults to a "queue" directory next to DB_PATH, so it lives under the
# ./data:/data mount that already holds the database - no new volume. Content is
# deleted as soon as the import is done, failed, or abandoned.
#QUEUE_PAYLOAD_DIR=/data/queue

# Total size bound over all retained uploads. Exceeding it makes the new import fail
# permanently with a notification, rather than displacing content another queued import
# still needs.
#QUEUE_PAYLOAD_MAX_MB=100
