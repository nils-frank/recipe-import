# Copy to .env, mode 600, then fill in real values. Never commit .env.

# Required - Mealie API token for the user recipe-import writes as.
MEALIE_TOKEN=changeme

# Required - Home Assistant long-lived access token, used to push a notification
# after each import.
HA_TOKEN=changeme

# Required - name of the Home Assistant notify.* channel to push to, without the
# "notify." prefix (e.g. mobile_app_your_phone). Must accept a data.url field so the
# notification can link to the imported recipe - a plain notify.send_message channel
# cannot.
HA_NOTIFY_TARGET=changeme

# Required - API key for the LLM fallback used when structured recipe data can't be
# scraped from the page (recipe-scrapers/extruct/trafilatura all come up empty).
LLM_API_KEY=changeme

# Required - bearer token for POST /import/file (the image/PDF upload path). Generate
# with: openssl rand -hex 24
IMPORT_TOKEN=changeme

# Optional - override only if your setup differs from the defaults below.
#MEALIE_URL=http://localhost:30081
#HA_URL=http://localhost:8123
#LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#LLM_MODEL=gemini-3.6-flash
#DB_PATH=/data/recipe-import.db
#RATE_LIMIT_PER_HOUR=20
#LOG_LEVEL=INFO

# Optional - upload path limits (POST /import/file). MAX_UPLOAD_MB is the combined
# size of all files in one request; requests over the limit are rejected, not truncated.
#MAX_UPLOAD_MB=12
#MAX_UPLOAD_FILES=4
#MAX_PDF_PAGES=10

# Optional - default true. After extraction, an extra LLM call rewrites the recipe
# title into something readable (drops author/site name/emoji/"recipe"). Costs one
# additional LLM call per import; set to false to skip it.
#NAMING_ENABLED=true
